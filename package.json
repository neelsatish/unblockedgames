{
  "name": "doodle-dash",
  "version": "1.0.0",
  "description": "Multiplayer draw-and-guess game with room codes",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node test.js && node games/rarefinds/engine.test.js",
    "build:rarefinds": "node games/rarefinds/build.js",
    "rarefinds:games": "node games/rarefinds/make-games.js --add 7",
    "rarefinds:check": "node games/rarefinds/check.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.21.2",
    "socket.io": "^4.8.1"
  }
}
